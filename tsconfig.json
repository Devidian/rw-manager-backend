{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "plugins": [
      {
        "transform": "typia/lib/transform"
      }
    ],
    "paths": {
      "@api/*": ["src/api/*"],
      "@db/*": ["src/db/*"],
      "@utils/*": ["src/utils/*"],
      "@interfaces/*": ["src/interfaces/*"]
    },
    "strictNullChecks": true,
  },
  "include": ["src", "tests/index.ts", "properties.d.ts"]
}
