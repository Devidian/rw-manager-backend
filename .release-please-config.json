{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "release-as": "0.6.1",
      "include-v-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "perf",
          "section": "Changed"
        },
        {
          "type": "refactor",
          "section": "Changed"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "build",
          "section": "Build"
        },
        {
          "type": "ci",
          "section": "Build"
        },
        {
          "type": "chore",
          "section": "Maintenance"
        },
        {
          "type": "test",
          "section": "Tests"
        }
      ]
    }
  }
}
